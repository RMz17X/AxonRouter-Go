# AxonRouter-Go environment contract
# Copy to .env and fill in values. The compose stacks
# (docker-compose.single.yml / docker-compose.cluster.yml) read this file;
# a bare binary run reads the same variables from its own environment.

# ── Compose stack ─────────────────────────────────────────────────────
# PostgreSQL is the only database (the SQLite era ended at P4). The
# stacks assemble DATABASE_URL from these parts, so the password has
# exactly one home: here.
POSTGRES_USER=axonrouter
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=axonrouter

# Required by the gateway in every topology: the session/token signing
# secret. In a cluster every node must share the same value.
JWT_SECRET=change-me-to-a-long-random-secret

# Host port the gateway (single) or nginx (cluster) is published on.
PORT=3177

# Dashboard password seeded on first boot against an empty database.
# Change it from the dashboard afterwards.
INITIAL_PASSWORD=change-me

# Container marker — set by the Docker image and both compose stacks,
# never by hand: it disables the self-updater (container updates are new
# images). A bare binary run leaves it unset and keeps self-update.
# AXONROUTER_IN_CONTAINER=1

# Cluster stack only: how many gateway replicas nginx fronts.
APP_REPLICAS=2

# PostgreSQL connection budget — both sides of one equation. Each
# gateway node opens up to PG_POOL_MAX_OPEN connections; PostgreSQL
# accepts PG_MAX_CONNECTIONS in total. Keep the invariant
#   APP_REPLICAS × PG_POOL_MAX_OPEN + 10 ≤ PG_MAX_CONNECTIONS
# (the +10 is headroom for the migrator and operator shells). Raising
# the pool alone past the server's limit makes PostgreSQL refuse
# connections (SQLSTATE 53300) and the gateway fail closed.
PG_POOL_MAX_OPEN=10
PG_POOL_MAX_IDLE=5
PG_MAX_CONNECTIONS=100

# Grace window for draining in-flight streams on shutdown; the stacks
# pair it with an equal stop_grace_period (P3 default is 30s).
# SHUTDOWN_GRACE_SECONDS=30

# Upgrade path (migrate profile): directory holding the legacy
# data.sqlite from a pre-P4 install. The migrator opens the database
# read-only, but the directory is mounted writable: a WAL-mode source
# needs space for its -shm/-wal recovery sidecars.
# LEGACY_DIR=./legacy

# ── Bare binary (no compose) ──────────────────────────────────────────
# DATABASE_URL may be set whole instead of via the POSTGRES_* parts:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=disable
# A boot without DATABASE_URL is a fatal error — there is no fallback.
#
# Non-DB state root (CLI tokens/machine-id, uploads, provider
# instruction files, tunnel state, catalog cache). In compose this is
# the appdata volume at /data.
DATA_DIR=/var/lib/axonrouter-go

# Speed layer (optional; P3): point at Valkey/Redis to share hot state
# across nodes. VALKEY_URL wins over REDIS_URL. Unset = per-node memory
# (single-node mode). A configured-but-dead server degrades the gateway
# to PostgreSQL, never to divergent per-node memory.
# VALKEY_URL=valkey://host:6379
# REDIS_URL=redis://host:6379

# Token saver toggles (all default off except RTK):
# RTK_ENABLED=true
# CAVEMAN_ENABLED=false
# PONYTAIL_ENABLED=false

# OAuth client credentials
# Set these to override built-in defaults. Hardcoded fallbacks exist for
# well-known public clients (antigravity, gemini-cli, xai, codex, iflow, etc.)
# so most users don't need to touch these.
# ANTIGRAVITY_OAUTH_CLIENT_ID=
# ANTIGRAVITY_OAUTH_CLIENT_SECRET=
# GEMINI_CLI_OAUTH_CLIENT_ID=
# GEMINI_CLI_OAUTH_CLIENT_SECRET=
# XAI_OAUTH_CLIENT_ID=
# XAI_OAUTH_CLIENT_SECRET=
# CODEX_OAUTH_CLIENT_ID=
# CODEX_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
# IFLOW_OAUTH_CLIENT_ID=
# IFLOW_OAUTH_CLIENT_SECRET=
# KIMI_CODING_OAUTH_CLIENT_ID=
# KIMI_CODING_OAUTH_CLIENT_SECRET=
# QWEN_OAUTH_CLIENT_ID=
# QWEN_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=

# Outbound proxy (optional)
# HTTP_PROXY=
# HTTPS_PROXY=

# When every account of a provider is in cooldown, serve the request through
# the account that frees up first instead of failing. Same effect as the
# "Force Fallback" toggle in Settings -> Default Routing Strategy; upstream parity.
# FORCE_FALLBACK_ON_ALL_UNAVAILABLE=true

# Set to true or 1 to forbid the insecure-TLS retry. By default a request that
# fails certificate verification is replayed once with verification disabled,
# which is what gets through a corporate proxy or antivirus that re-signs TLS.
# STRICT_SSL=true
